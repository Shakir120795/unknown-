# Contract deployment
RPC_URL=
DEPLOYER_PRIVATE_KEY=
IMD_TOKEN_ADDRESS=
TREASURY_ADDRESS=
IMD_DECIMALS=18
CHAIN_ID=1
HIDDEN_BASE_URI=ipfs://<HIDDEN_METADATA_CID>/
REVEALED_BASE_URI=ipfs://<REVEALED_METADATA_CID>/
PROVENANCE_HASH=0x<64-hex-chars>

# Phase prices in IMD, six comma-separated values
PHASE_PRICES=0.2,0.5,0.8,1.1,1.5,2.0
# Difficulty measured in leading zero bits. Must increase every phase.
PHASE_DIFFICULTY_BITS=16,18,20,22,24,26

# Web build
VITE_CHAIN_ID=1
VITE_CONTRACT_ADDRESS=
VITE_IMD_TOKEN_ADDRESS=
VITE_IMD_DECIMALS=18
VITE_EXPLORER=https://etherscan.io
